# Copy to .env. Use unique, private values; never commit .env.
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-with-a-long-local-db-password

# Generate a random secret of at least 32 bytes for HS256.
JWT_SECRET=replace-with-at-least-32-random-characters

LMS_ADMIN_EMAIL=admin@example.com
LMS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
LMS_ADMIN_NAME=Library Admin

# Optional SMTP credentials
MAIL_USERNAME=
MAIL_PASSWORD=
